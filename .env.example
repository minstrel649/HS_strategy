DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=8000
DEEPSEEK_REASONING_EFFORT=none
# Folder containing Hearthstone_* directories, each with a Power.log.
HEARTHSTONE_LOG_ROOT=D:/70_Games/Battle.net/Hearthstone/Logs
# Legacy key name: normal gameplay also accepts this as a DeepSeek credential.
AI_GATEWAY_API_KEY=
# Your BattleTag exactly as Power.log prints it; runtime/health.mjs reads the game result with it.
JEV_ACCOUNT="Name#1234"
